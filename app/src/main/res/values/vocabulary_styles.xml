<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ListItemBaseStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="fontFamily">@font/inter</item>
        <item name="fontStyle">normal</item>
        <item name="fontWeight">400</item>
    </style>

    <style name="ListItemHeaderStyle" parent="ListItemBaseStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ListItemSubtitleStyle" parent="ListItemBaseStyle">
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ShoppingListSubtleStyle" parent="ListItemBaseStyle">
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ShoppingListNormalStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">textStart</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="ShoppingListBoldStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">35sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="RecapHeadingViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">26sp</item>
    </style>

    <style name="RecapTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">textStart</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="LearningTextViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="ReceiptTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RecipeHeading2Style" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="RecipeSubtleTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">textStart</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="EditTextWithoutUnderline" parent="ThemeOverlay.Material3.TextInputEditText">
        <item name="android:background">@null</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">1000</item>
        <item name="backgroundTint">@color/app_gray_900</item>
        <item name="backgroundTintMode">add</item>
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="AppBottomNavCustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/app_green_0</item>
    </style>

    <style name="AppClickActionButton" parent="ShapeAppearanceOverlay.Material3.FloatingActionButton">
        <item name="backgroundTint">@color/app_green_300</item>
    </style>
</resources>