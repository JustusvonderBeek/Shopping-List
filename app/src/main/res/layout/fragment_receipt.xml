<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".fragments.recipe.RecipeFragment">

    <data>

        <variable
            name="recipeVM"
            type="com.cloudsheeptech.shoppinglist.fragments.recipe.RecipeViewModel" />

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="8dp"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:dotsColor="@color/shopping_gray"
                app:selectedDotColor="@color/add_green"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewPager" />

            <TextView
                android:id="@+id/receiptName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/dotsIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@={recipeVM.recipe.name}"
                style="@style/ReceiptTitleStyle" />

            <LinearLayout
                android:id="@+id/portionConfigWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/receiptName"
                app:layout_constraintStart_toStartOf="@id/receiptName"
                app:layout_constraintEnd_toEndOf="@id/receiptName"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text='@{String.format("%s: %d", recipeVM.portionsText, recipeVM.portions)}'
                    android:layout_weight="2"
                    android:textAlignment="textStart"
                    android:gravity="center_vertical"
                    style="@style/ShoppingListNormalStyle" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="1dp"
                    android:clickable="true"
                    android:padding="0dp"
                    app:elevation="0dp"
                    android:onClick="@{() -> recipeVM.decreasePortions()}"
                    android:src="@drawable/ic_minus"
                    app:backgroundTint="@color/decrease_orange" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="1dp"
                    android:clickable="true"
                    android:padding="0dp"
                    android:layout_marginStart="8dp"
                    app:elevation="0dp"
                    android:onClick="@{() -> recipeVM.increasePortions()}"
                    android:src="@drawable/ic_plus"
                    app:backgroundTint="@color/add_green" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/receiptIngredientListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/portionConfigWrapper"
                app:layout_constraintStart_toStartOf="@id/portionConfigWrapper"
                app:layout_constraintEnd_toEndOf="@id/portionConfigWrapper"
                tools:listitem="@layout/receipt_item"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <View
                android:id="@+id/ingredientsAndDescDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/receiptIngredientListView"
                app:layout_constraintStart_toStartOf="@id/receiptIngredientListView"
                app:layout_constraintEnd_toEndOf="@id/receiptIngredientListView"
                android:background="@android:color/darker_gray" />

            <TextView
                android:id="@+id/stepsHeaderText"
                style="@style/ShoppingListNormalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/steps_header"
                android:textAlignment="viewStart"
                app:layout_constraintEnd_toEndOf="@id/ingredientsAndDescDivider"
                app:layout_constraintStart_toStartOf="@id/ingredientsAndDescDivider"
                app:layout_constraintTop_toBottomOf="@id/ingredientsAndDescDivider" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/receiptDescriptionListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="@id/stepsHeaderText"
                app:layout_constraintStart_toStartOf="@id/stepsHeaderText"
                app:layout_constraintTop_toBottomOf="@id/stepsHeaderText"
                tools:listitem="@layout/receipt_description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addToShoppingListButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/receiptDescriptionListView"
                app:layout_constraintStart_toStartOf="@id/receiptDescriptionListView"
                app:layout_constraintEnd_toEndOf="@id/receiptDescriptionListView"
                android:onClick="@{() -> recipeVM.addRecipeToShoppingList()}"
                android:text="@string/btn_add_to_list" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>