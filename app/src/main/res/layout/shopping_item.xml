<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="item"
            type="com.cloudsheeptech.shoppinglist.list.model.AppItem" />

        <variable
            name="amountName"
            type="java.lang.String" />

        <variable
            name="clickListener"
            type="com.cloudsheeptech.shoppinglist.ui.list.detail.ShoppingListItemAdapter.ShoppingItemClickListener" />

        <variable
            name="checkClickListener"
            type="com.cloudsheeptech.shoppinglist.ui.list.detail.ShoppingListItemAdapter.ShoppingItemCheckboxClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{() -> checkClickListener.onClick(item)}"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        style="@style/ShoppingListItemStyle"
        >

        <LinearLayout
            android:id="@+id/itemWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:padding="8dp">

            <CheckBox
                android:id="@+id/itemCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="0dp"
                android:scaleX="1.45"
                android:scaleY="1.45"
                android:checked="@{item.checked}"
                android:padding="0dp"
                />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='@{String.format("%s", item.name)}'
                    style="@style/ListItemHeaderStyle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='@{String.format("%s: %d", amountName, item.quantity)}'
                    style="@style/ListItemSubtitleStyle" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="0dp"
                    android:clickable="true"
                    android:onClick="@{() -> clickListener.onClick(item, -1)}"
                    android:padding="0dp"
                    app:elevation="0dp"
                    android:src="@drawable/ic_minus"
                    style="@style/AppNegativeActionButton" />

                <!--                <TextView-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:text='@{String.format("%d", item.Quantity)}'-->
                <!--                    android:layout_gravity="center"-->
                <!--                    style="@style/LearningTextViewStyle"-->
                <!--                    />-->

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:onClick="@{() -> clickListener.onClick(item, 1)}"
                    app:elevation="0dp"
                    android:src="@drawable/ic_plus"
                    style="@style/AppPositiveActionButton" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>