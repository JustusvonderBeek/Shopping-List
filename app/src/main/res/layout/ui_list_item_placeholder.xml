<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    >

    <TextView
        android:id="@+id/list_placeholder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_list_placeholder_title"
        android:justificationMode="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ShoppingListBoldStyle"
        android:textSize="24sp"
        />

    <TextView
        android:id="@+id/list_placeholder_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/empty_list_placeholder_desc_1"
        app:layout_constraintEnd_toEndOf="@+id/list_placeholder_title"
        app:layout_constraintStart_toStartOf="@+id/list_placeholder_title"
        app:layout_constraintTop_toBottomOf="@+id/list_placeholder_title"
        style="@style/ShoppingListNormalStyle"
        />

    <TextView
        android:id="@+id/list_placeholder_explanation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/empty_list_placeholder_desc_2"
        android:justificationMode="inter_word"
        app:layout_constraintEnd_toEndOf="@+id/list_placeholder_title"
        app:layout_constraintStart_toStartOf="@+id/list_placeholder_title"
        app:layout_constraintTop_toBottomOf="@+id/list_placeholder_subtitle"
        style="@style/ShoppingListNormalStyle"
        />
</androidx.constraintlayout.widget.ConstraintLayout>