        <!-- Primary -->
        <item name="colorPrimary">#006C4A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#89F8C7</item>
        <item name="colorOnPrimaryContainer">#002115</item>

        <!-- Secondary -->
        <item name="colorSecondary">#4D6357</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#CFE9D9</item>
